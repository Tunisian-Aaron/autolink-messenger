# Optional settings. Copy this file to ".env" (same folder) and fill in what you need.
# The .env file stays on your computer: git ignores it.

# Claude writes the personal version of each message and sorts people into groups.
# Get a key in the Claude Console, https://platform.claude.com/ (usage is billed to that account).
# Not needed if Claude Code is installed and logged in on this computer.
ANTHROPIC_API_KEY=

# Your name, used for {sender_name} when a command doesn't pass --sender-name.
# OUTREACH_SENDER_NAME=Sam

# Which Claude model to use (default: claude-opus-5-5).
# OUTREACH_AI_MODEL=claude-opus-5-5

# Keep the database somewhere else (default: outreach.db in this folder).
# OUTREACH_DB=/path/to/outreach.db
